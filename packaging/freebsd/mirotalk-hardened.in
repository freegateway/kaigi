#!/bin/sh

# PROVIDE: mirotalk
# REQUIRE: LOGIN NETWORKING
# KEYWORD: shutdown

. /etc/rc.subr

name="mirotalk"
rcvar="mirotalk_enable"

load_rc_config "$name"

: ${mirotalk_enable:="NO"}
: ${mirotalk_daemon_user:="www"}
: ${mirotalk_daemon_group:="www"}

pidfile="/var/run/mirotalk/${name}.pid"
procname="%%LOCALBASE%%/bin/node"
command="/usr/sbin/daemon"
command_args="-f -p ${pidfile} -u ${mirotalk_daemon_user} -o /var/log/mirotalk/mirotalk.log %%LOCALBASE%%/bin/node app/src/Server.js"

start_precmd="mirotalk_precmd"

mirotalk_precmd()
{
	install -d -m 0750 -o "${mirotalk_daemon_user}" -g "${mirotalk_daemon_group}" /var/run/mirotalk || return 1
	install -d -m 0750 -o "${mirotalk_daemon_user}" -g "${mirotalk_daemon_group}" /var/log/mirotalk || return 1
	install -d -m 0755 -o root -g wheel "%%PREFIX%%/etc/mirotalk" || return 1

	if [ ! -r "%%PREFIX%%/etc/mirotalk/mirotalk.conf" ]; then
		echo "${name}: configuration file is not readable: %%PREFIX%%/etc/mirotalk/mirotalk.conf"
		return 1
	fi

	if [ -L "%%PREFIX%%/etc/mirotalk/jwt-secret" ]; then
		echo "${name}: jwt-secret must not be a symlink"
		return 1
	fi

	if [ ! -f "%%PREFIX%%/etc/mirotalk/jwt-secret" ]; then
		umask 077
		dd if=/dev/urandom bs=32 count=1 2>/dev/null | hexdump -ve '1/1 "%02x"' > "%%PREFIX%%/etc/mirotalk/jwt-secret" || return 1
	fi

	JWT_SECRET="$(cat "%%PREFIX%%/etc/mirotalk/jwt-secret")" || return 1
	if [ -z "${JWT_SECRET}" ]; then
		echo "${name}: JWT secret file is empty: %%PREFIX%%/etc/mirotalk/jwt-secret"
		return 1
	fi
	export JWT_SECRET

	if [ ! -r "%%PREFIX%%/etc/mirotalk/users" ]; then
		echo "${name}: users file is not readable: %%PREFIX%%/etc/mirotalk/users"
		return 1
	fi
	HOST_USERS="$(cat "%%PREFIX%%/etc/mirotalk/users")" || return 1
	export HOST_USERS

	cd "%%WWWDIR%%" || return 1
}

run_rc_command "$1"
