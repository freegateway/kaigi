{
    "name": "kaigi",
    "version": "0.1.0-dev",
    "description": "FreeGateway Kaigi: privacy-hardened FreeBSD video conferencing",
    "main": "Server.js",
    "scripts": {
        "test": "node scripts/test.cjs",
        "start": "node app/src/Server.js",
        "dev": "node --watch app/src/Server.js",
        "debug": "DEBUG='mediasoup*' node app/src/Server.js",
        "lang": "node app/src/scripts/extract-ui-lang.js",
        "build:mediasoup-client": "npx esbuild node_modules/mediasoup-client/lib/index.js --bundle --minify --format=iife --global-name=mediasoupClient --outfile=public/sfu/MediasoupClient.js --platform=browser",
        "lint": "npx prettier --write ."
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/freegateway/kaigi"
    },
    "keywords": [
        "webrtc",
        "socket.io",
        "broadcasting",
        "sfu",
        "nodejs",
        "video",
        "audio",
        "openai",
        "oidc",
        "chatgpt",
        "rtmp",
        "poll",
        "client",
        "server",
        "streaming",
        "realtime"
    ],
    "author": "Miroslav Pejic",
    "license": "AGPL-3.0",
    "engines": {
        "node": ">=24"
    },
    "dependencies": {
        "async-mutex": "^0.5.0",
        "axios": "^1.20.0",
        "chokidar": "^5.0.0",
        "colors": "1.4.0",
        "compression": "1.8.2",
        "cors": "2.8.6",
        "crypto-js": "4.2.0",
        "dompurify": "^3.4.17",
        "dotenv": "^18.0.8",
        "express": "5.3.0",
        "express-openid-connect": "^3.4.0",
        "express-rate-limit": "^8.7.1",
        "he": "^2.0.0",
        "helmet": "^8.3.0",
        "httpolyglot": "0.1.2",
        "ical-generator": "^11.1.2",
        "js-yaml": "^5.5.0",
        "jsdom": "^30.1.3",
        "jsonwebtoken": "^9.0.3",
        "mediasoup": "^3.31.0",
        "mediasoup-client": "3.25.3",
        "mime-types": "^3.0.2",
        "nodemailer": "^10.2.1",
        "qs": "6.16.1",
        "sanitize-filename": "^1.6.4",
        "socket.io": "4.8.4",
        "swagger-ui-express": "5.0.1",
        "uuid": "14.0.3",
        "ldapts": "9.2.0"
    },
    "devDependencies": {
        "esbuild": "^0.28.2",
        "mocha": "^12.0.3",
        "node-fetch": "^3.3.2",
        "prettier": "3.9.10",
        "proxyquire": "^2.1.3",
        "should": "^13.2.3",
        "sinon": "^22.1.0"
    },
    "overrides": {
        "proxy-addr": "2.0.8",
        "source-map-js": "1.2.2",
        "joi": "17.13.8"
    }
}
